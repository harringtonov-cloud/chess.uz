# Скопируйте в .env.local (локально) и в Vercel -> Project Settings -> Environment Variables (необязательно: значения по умолчанию уже в коде).
# Значения берутся в Firebase Console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Серверная часть (api/auth.ts): коды из письма для регистрации и восстановления пароля ---
# Только в Vercel -> Environment Variables (НЕ в репозиторий и не с префиксом VITE_).
# Firebase Console -> Project settings -> Service accounts -> Generate new private key; содержимое JSON одной строкой.
FIREBASE_SERVICE_ACCOUNT=
# Любой SMTP: Gmail (smtp.gmail.com, порт 465, пароль приложения), Brevo, Resend, Mailgun и т.д.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Необязательно, например: chess.uz <noreply@chess.uz>
MAIL_FROM=
