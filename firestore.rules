rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Игрок target заблокировал игрока who: тот не может слать ему запросы, приглашения и уведомления
    function isBlockedBy(target, who) {
      return exists(/databases/$(database)/documents/users/$(target)/blocks/$(who));
    }


    // ---------- Модерация ----------
    // Роли лежат в коллекции admins (документ с id = uid игрока, поле role = 'admin' или 'moderator').
    // Менять её может только владелец сайта (см. isOwner), остальным она доступна на чтение.
    // Владелец сайта: всегда администратор и единственный, кто назначает сотрудников
    function isOwner() {
      return signedIn() && request.auth.uid == 'sd5jmuq34PXwC17XxTj87VwK8QZ2';
    }
    function isMod() {
      return isOwner() || (signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role in ['admin', 'moderator']);
    }
    function isAdmin() {
      return isOwner() || (signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'admin');
    }
    // Действует ли на игрока санкция одного из видов (срок ещё не вышел)
    function sanctioned(uid, kinds) {
      return exists(/databases/$(database)/documents/bans/$(uid))
        && get(/databases/$(database)/documents/bans/$(uid)).data.type in kinds
        && get(/databases/$(database)/documents/bans/$(uid)).data.until > request.time;
    }
    function notBanned() {
      return !sanctioned(request.auth.uid, ['ban']);
    }
    // Мьют запрещает только чаты, бан запрещает и чаты
    function notMuted() {
      return !sanctioned(request.auth.uid, ['ban', 'mute']);
    }

    match /users/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'bio', 'ratings']);
      allow delete: if false;

      // Чёрный список: видит и меняет только сам игрок
      match /blocks/{bid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && bid != uid
          && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt'])
          && request.resource.data.uid == bid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 24;
        allow delete: if signedIn() && request.auth.uid == uid;
      }

      // Уведомления: читает, отмечает прочитанными и удаляет только владелец;
      // создать (или обновить своё же) может отправитель, если его не заблокировали
      match /notifications/{nid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && validNotification(request.resource.data, uid);
        allow update: if signedIn() && (
          (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
          || (resource.data.fromUid == request.auth.uid
            && validNotification(request.resource.data, uid))
        );
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    function validNotification(d, uid) {
      return d.keys().hasOnly(['kind', 'fromUid', 'fromName', 'title', 'body', 'link', 'read', 'createdAt'])
        && d.fromUid == request.auth.uid
        && uid != request.auth.uid
        && (d.kind in ['friend_request', 'friend_accepted', 'message', 'game_invite', 'your_turn',
                       'club_request', 'club_approved', 'tournament_round']
            || (d.kind in ['system', 'moderation'] && isMod()))
        && d.fromName is string && d.fromName.size() <= 24
        && d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.body is string && d.body.size() <= 200
        && d.link is string && d.link.size() <= 120 && d.link.matches('^/[A-Za-z0-9_/.?=&#-]*$')
        && d.read == false
        && d.createdAt == request.time
        && (!isBlockedBy(uid, request.auth.uid) || isMod());
    }

    // Дружба: один документ на пару игроков, id = uid-ы по алфавиту через «_»
    match /friendships/{pid} {
      allow read: if signedIn() && request.auth.uid in resource.data.users;

      // Запрос отправляет сам инициатор, статус всегда «pending»
      allow create: if signedIn()
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && request.resource.data.requester == request.auth.uid
        && request.resource.data.status == 'pending'
        && (pid == request.resource.data.users[0] + '_' + request.resource.data.users[1]
            || pid == request.resource.data.users[1] + '_' + request.resource.data.users[0])
        && !isBlockedBy(
          request.resource.data.users[0] == request.auth.uid
            ? request.resource.data.users[1] : request.resource.data.users[0],
          request.auth.uid);

      // Принять запрос может только получатель; менять другие поля нельзя
      allow update: if signedIn()
        && request.auth.uid in resource.data.users
        && resource.data.status == 'pending'
        && resource.data.requester != request.auth.uid
        && request.resource.data.status == 'accepted'
        && request.resource.data.users == resource.data.users
        && request.resource.data.requester == resource.data.requester;

      // Отклонить, отменить или удалить из друзей может любой из двоих
      allow delete: if signedIn() && request.auth.uid in resource.data.users;

      // Личные сообщения — только между подтверждёнными друзьями
      match /messages/{mid} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pid)).data.users;
        allow create: if signedIn()
          && notMuted()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 300
          && get(/databases/$(database)/documents/friendships/$(pid)).data.status == 'accepted'
          && request.auth.uid in get(/databases/$(database)/documents/friendships/$(pid)).data.users;
      }
    }

    // ---------- Клубы ----------
    function clubDoc(cid) {
      return /databases/$(database)/documents/clubs/$(cid);
    }
    function clubMemberPath(cid, uid) {
      return /databases/$(database)/documents/clubs/$(cid)/members/$(uid);
    }
    function clubRole(cid) {
      return signedIn() && exists(clubMemberPath(cid, request.auth.uid))
        ? get(clubMemberPath(cid, request.auth.uid)).data.role
        : 'none';
    }
    function isClubMember(cid) {
      return clubRole(cid) in ['owner', 'admin', 'member'];
    }
    function isClubAdmin(cid) {
      return clubRole(cid) in ['owner', 'admin'];
    }
    function validClub(d) {
      return d.name is string && d.name.size() >= 3 && d.name.size() <= 40
        && d.description is string && d.description.size() <= 300
        && d.isOpen is bool;
    }

    match /clubs/{cid} {
      allow read: if true;
      allow create: if signedIn()
        && notBanned()
        && request.resource.data.ownerId == request.auth.uid
        && validClub(request.resource.data);
      // Менять название, описание и тип клуба может только владелец
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && validClub(request.resource.data);
      allow delete: if false;

      match /members/{mid} {
        allow read: if signedIn();

        // Вступить в открытый клуб, подать заявку в закрытый, либо создать клуб (запись владельца)
        allow create: if signedIn()
          && mid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 24
          && (
            (request.resource.data.role == 'owner'
              && getAfter(clubDoc(cid)).data.ownerId == request.auth.uid)
            || (request.resource.data.role == 'member'
              && exists(clubDoc(cid)) && get(clubDoc(cid)).data.isOpen == true)
            || (request.resource.data.role == 'pending'
              && exists(clubDoc(cid)) && get(clubDoc(cid)).data.isOpen == false)
          );

        // Одобрить заявку может админ; назначить или снять админа — только владелец
        allow update: if signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
          && (
            (isClubAdmin(cid) && resource.data.role == 'pending' && request.resource.data.role == 'member')
            || (clubRole(cid) == 'owner'
              && resource.data.role in ['member', 'admin']
              && request.resource.data.role in ['member', 'admin'])
          );

        // Выйти (или отозвать заявку) может сам участник, кроме владельца; исключать — админы
        allow delete: if signedIn() && (
          (mid == request.auth.uid && resource.data.role != 'owner')
          || (isClubAdmin(cid) && resource.data.role in ['member', 'pending'])
          || (clubRole(cid) == 'owner' && resource.data.role == 'admin')
        );
      }

      match /messages/{mid} {
        allow read: if isClubMember(cid);
        allow create: if isClubMember(cid)
          && notMuted()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 300;
        allow delete: if isClubAdmin(cid) || isMod();
      }
    }

    // ---------- Турниры (швейцарская система) ----------
    function tournamentDoc(tid) {
      return /databases/$(database)/documents/tournaments/$(tid);
    }
    function isOrganizer(tid) {
      return signedIn() && get(tournamentDoc(tid)).data.organizerId == request.auth.uid;
    }
    // Арена-турнир: обычный документ турнира с type = 'arena' и временем начала/конца (мс)
    function isArena(tid) {
      return get(tournamentDoc(tid)).data.get('type', '') == 'arena';
    }
    function arenaOpen(tid) {
      return isArena(tid) && request.time.toMillis() < get(tournamentDoc(tid)).data.endsAt;
    }
    function gameDoc(gid) {
      return /databases/$(database)/documents/games/$(gid);
    }
    // Партия создана для этой арены, и в ней играет указанный игрок
    function arenaGameHas(tid, gid, uid) {
      return gid is string
        && getAfter(gameDoc(gid)).data.get('arenaId', '') == tid
        && getAfter(gameDoc(gid)).data.participants.hasAll([uid]);
    }

    match /tournaments/{tid} {
      allow read: if true;
      allow create: if signedIn()
        && notBanned()
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 50
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.base is int && request.resource.data.base >= 30 && request.resource.data.base <= 10800
        && request.resource.data.inc is int && request.resource.data.inc >= 0 && request.resource.data.inc <= 180
        && request.resource.data.rounds is int && request.resource.data.rounds >= 1 && request.resource.data.rounds <= 9
        && request.resource.data.maxPlayers is int && request.resource.data.maxPlayers >= 2 && request.resource.data.maxPlayers <= 64
        && request.resource.data.status == 'registration'
        && request.resource.data.currentRound == 0;
      // Арена: от 10 минут до 3 часов, без туров
      allow create: if signedIn()
        && notBanned()
        && request.resource.data.organizerId == request.auth.uid
        && request.resource.data.get('type', '') == 'arena'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 50
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.base is int && request.resource.data.base >= 30 && request.resource.data.base <= 10800
        && request.resource.data.inc is int && request.resource.data.inc >= 0 && request.resource.data.inc <= 180
        && request.resource.data.rounds == 0
        && request.resource.data.maxPlayers is int && request.resource.data.maxPlayers >= 2 && request.resource.data.maxPlayers <= 500
        && request.resource.data.status == 'registration'
        && request.resource.data.currentRound == 0
        && request.resource.data.startsAt is int
        && request.resource.data.endsAt is int
        && request.resource.data.endsAt - request.resource.data.startsAt >= 600000
        && request.resource.data.endsAt - request.resource.data.startsAt <= 10800000
        && request.resource.data.startsAt >= request.time.toMillis() - 300000;
      // Менять турнир (старт, следующий тур, завершение) может только организатор
      allow update: if signedIn()
        && resource.data.organizerId == request.auth.uid
        && request.resource.data.organizerId == resource.data.organizerId;
      allow delete: if false;

      match /players/{pid} {
        allow read: if true;
        // Записаться можно только пока идёт регистрация
        allow create: if signedIn()
          && pid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 24
          && get(tournamentDoc(tid)).data.status == 'registration'
          && !isArena(tid);
        allow delete: if signedIn() && (
          (pid == request.auth.uid && get(tournamentDoc(tid)).data.status == 'registration' && !isArena(tid))
          || isOrganizer(tid)
        );

        // Арена: записаться можно, пока она не закончилась
        allow create: if signedIn()
          && notBanned()
          && pid == request.auth.uid
          && arenaOpen(tid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'rating', 'waiting', 'paused', 'gameId', 'seenAt', 'joinedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.name is string && request.resource.data.name.size() <= 24
          && request.resource.data.rating is number
          && request.resource.data.waiting == false
          && request.resource.data.paused == false
          && request.resource.data.gameId == null
          && request.resource.data.seenAt is number;

        allow update: if signedIn() && isArena(tid) && (
          // сам игрок: пауза, «ищу соперника», отметка присутствия; партию себе ставит только
          // вместе с созданием партии арены с самим собой в числе участников
          (pid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waiting', 'paused', 'seenAt', 'gameId'])
            && (request.resource.data.gameId == resource.data.gameId
                || request.resource.data.gameId == null
                || (resource.data.gameId == null && arenaOpen(tid)
                    && arenaGameHas(tid, request.resource.data.gameId, request.auth.uid))))
          // подбор: соперник записывает в документ ожидающего игрока id новой партии
          || (pid != request.auth.uid
            && notBanned()
            && arenaOpen(tid)
            && resource.data.waiting == true
            && resource.data.paused == false
            && resource.data.gameId == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['waiting', 'gameId'])
            && request.resource.data.waiting == false
            && arenaGameHas(tid, request.resource.data.gameId, pid)
            && arenaGameHas(tid, request.resource.data.gameId, request.auth.uid))
        );
      }

      // Итоги партий арены: каждый игрок записывает свой результат, только если такая же
      // закончившаяся партия этой арены есть в базе
      match /results/{rid} {
        allow read: if true;
        allow create: if signedIn()
          && isArena(tid)
          && request.resource.data.keys().hasOnly(['uid', 'gameId', 'result', 'opponent', 'color', 'at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.gameId is string
          && rid == request.resource.data.gameId + '_' + request.auth.uid
          && request.resource.data.at is number
          && request.resource.data.result in ['win', 'draw', 'loss']
          && validArenaResult(tid, request.resource.data);
        allow update, delete: if false;
      }

      function validArenaResult(arenaId, d) {
        let g = get(gameDoc(d.gameId)).data;
        return g.status == 'finished'
          && g.get('arenaId', '') == arenaId
          && (
            (d.result == 'draw' && g.result == '1/2-1/2' && request.auth.uid in [g.white, g.black])
            || (d.result == 'win'
                && ((g.white == request.auth.uid && g.result == '1-0')
                    || (g.black == request.auth.uid && g.result == '0-1')))
            || (d.result == 'loss'
                && ((g.white == request.auth.uid && g.result == '0-1')
                    || (g.black == request.auth.uid && g.result == '1-0')))
          );
      }

      match /pairings/{pairId} {
        allow read: if true;
        // Жеребьёвку создаёт только организатор
        allow create: if isOrganizer(tid);
        allow update: if signedIn() && (
          // организатор может проставить результат вручную (неявка, отмена партии) или прикрепить партию
          (isOrganizer(tid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['result', 'gameId']))
          // игрок за белых прикрепляет созданную им партию
          || (request.auth.uid == resource.data.white
            && resource.data.gameId == null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gameId'])
            && request.resource.data.gameId is string
            && exists(/databases/$(database)/documents/games/$(request.resource.data.gameId))
            && get(/databases/$(database)/documents/games/$(request.resource.data.gameId)).data.white == resource.data.white)
          // участник записывает результат, только если такая же закончившаяся партия есть в базе
          || (request.auth.uid in [resource.data.white, resource.data.black]
            && resource.data.result == null
            && resource.data.gameId != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['result'])
            && get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.status == 'finished'
            && get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.white == resource.data.white
            && get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.black == resource.data.black
            && get(/databases/$(database)/documents/games/$(resource.data.gameId)).data.result == request.resource.data.result)
        );
        allow delete: if false;
      }
    }

    // Приглашения друга на партию
    match /invites/{iid} {
      allow read: if signedIn()
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn()
        && notBanned()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && !isBlockedBy(request.resource.data.to, request.auth.uid);
      allow delete: if signedIn()
        && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow update: if false;
    }

    match /games/{gid} {
      allow read: if true;

      // Создать партию может только участник (с баном нельзя)
      allow create: if signedIn()
        && notBanned()
        && (request.resource.data.white == request.auth.uid
            || request.resource.data.black == request.auth.uid)
        && (
          (request.resource.data.base is number
            && request.resource.data.base >= 10
            && request.resource.data.base <= 14400
            && request.resource.data.inc is number
            && request.resource.data.inc >= 0
            && request.resource.data.inc <= 300)
          // ежедневная партия: от 1 до 14 суток на ход, без добавки и без рейтинга
          || (request.resource.data.get('daily', false) == true
            && request.resource.data.base is number
            && request.resource.data.base >= 86400
            && request.resource.data.base <= 1209600
            && request.resource.data.inc == 0
            && request.resource.data.rated == false)
        );

      // Обновлять партию могут игроки; присоединиться может любой вошедший
      // пользователь, если партия ждёт соперника и он занимает свободное место.
      allow update: if signedIn() && (
        resource.data.white == request.auth.uid
        || resource.data.black == request.auth.uid
        || (resource.data.status == 'waiting'
            && request.resource.data.status == 'active'
            && notBanned()
            && (request.resource.data.white == request.auth.uid
                || request.resource.data.black == request.auth.uid))
      );

      allow delete: if signedIn()
        && resource.data.status == 'waiting'
        && (resource.data.white == request.auth.uid
            || resource.data.black == request.auth.uid);

      match /chat/{mid} {
        allow read: if true;
        allow create: if signedIn()
          && notMuted()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 300;
        // удалять сообщения могут сотрудники модерации
        allow delete: if isMod();
      }
    }

    // ---------- Форум ----------
    // Темы и ответы: писать могут вошедшие игроки без мьюта, удалять — автор или сотрудники.
    // Счётчик ответов в теме растёт только на единицу и только вместе с отметкой времени ответа.
    match /forumPosts/{pid} {
      allow read: if true;
      allow create: if signedIn()
        && notMuted()
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'title', 'body', 'replyCount', 'lastReplyAt', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 24
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3 && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 1 && request.resource.data.body.size() <= 2000
        && request.resource.data.replyCount == 0
        && request.resource.data.lastReplyAt == null
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn()
        && notMuted()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount', 'lastReplyAt'])
        && request.resource.data.replyCount == resource.data.replyCount + 1
        && request.resource.data.lastReplyAt == request.time;
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isMod());

      match /replies/{rid} {
        allow read: if true;
        allow create: if signedIn()
          && notMuted()
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 24
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 1 && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt == request.time;
        allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || isMod());
      }
    }

    // ---------- Модерация: роли, жалобы, санкции, журнал, объявление ----------

    // Роли: каждый видит только свою, сотрудники видят все; менять может только владелец
    match /admins/{aid} {
      allow read: if signedIn() && (aid == request.auth.uid || isMod());
      // назначать и снимать сотрудников может только владелец
      allow create, update: if isOwner()
        && aid != request.auth.uid
        && request.resource.data.keys().hasOnly(['role', 'name', 'addedBy', 'addedByName', 'createdAt'])
        && request.resource.data.role in ['admin', 'moderator']
        && request.resource.data.name is string && request.resource.data.name.size() <= 24
        && request.resource.data.addedBy == request.auth.uid
        && request.resource.data.addedByName is string && request.resource.data.addedByName.size() <= 24
        && request.resource.data.createdAt == request.time;
      allow delete: if isOwner();
    }

    // Жалобы: id = «uid жалобщика _ uid игрока _ id партии или profile», поэтому дубли невозможны
    match /reports/{rid} {
      allow read: if isMod() || (signedIn() && resource.data.reporterUid == request.auth.uid);
      allow create: if signedIn()
        && notBanned()
        && request.resource.data.keys().hasOnly(
          ['reporterUid', 'reporterName', 'targetUid', 'targetName', 'reason', 'details', 'gameId', 'status', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.targetUid.size() > 0 && request.resource.data.targetUid.size() <= 40
        && rid == request.auth.uid + '_' + request.resource.data.targetUid + '_'
                  + (request.resource.data.gameId == '' ? 'profile' : request.resource.data.gameId)
        && request.resource.data.reason in ['cheating', 'abuse', 'spam', 'name', 'stalling', 'sandbagging', 'other']
        && request.resource.data.reporterName is string && request.resource.data.reporterName.size() <= 24
        && request.resource.data.targetName is string && request.resource.data.targetName.size() <= 24
        && request.resource.data.details is string && request.resource.data.details.size() <= 500
        && request.resource.data.gameId is string && request.resource.data.gameId.size() <= 40
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time;
      // закрывать жалобу могут только сотрудники и только эти поля
      allow update: if isMod()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'action', 'note', 'resolvedBy', 'resolvedByName', 'resolvedAt'])
        && request.resource.data.status in ['resolved', 'dismissed'];
      allow delete: if isAdmin();
    }

    // Санкции: id = uid наказанного. Игрок видит свою, сотрудники — все.
    // Модератор — до 30 дней, бессрочно — только администратор.
    match /bans/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isMod());
      allow create, update: if isMod()
        && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['type', 'reason', 'until', 'by', 'byName', 'targetName', 'createdAt'])
        && request.resource.data.type in ['ban', 'mute']
        && request.resource.data.by == request.auth.uid
        && request.resource.data.reason is string && request.resource.data.reason.size() <= 200
        && request.resource.data.until is timestamp
        && request.resource.data.until > request.time
        && (isAdmin() || request.resource.data.until <= request.time + duration.value(31, 'd'))
        && request.resource.data.createdAt == request.time;
      allow delete: if isMod();
    }

    // Журнал действий: добавлять могут сотрудники, менять и удалять нельзя никому
    match /modLog/{lid} {
      allow read: if isMod();
      allow create: if isMod()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // Объявление сайта: видят все, меняет администратор
    match /config/{cid} {
      allow read: if true;
      allow write: if isAdmin() && cid == 'announcement';
    }
  }
}
